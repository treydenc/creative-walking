# Copy to .env and fill in. Never commit the filled-in version.

# AugmentOS / Mentra app API key, from the developer console. SECRET.
AUGMENTOS_API_KEY=

# OpenAI API key — generates the walk prompts. SECRET.
OPENAI_API_KEY=

# Where the Next.js web app is reachable. The glasses app calls back into it.
# In local dev this is the tunnel URL, not localhost, if the cloud needs to reach it.
NEXTJS_URL=http://localhost:3000
